# Copiá este archivo como ".env.local" (sin ".ejemplo") en la raíz del
# proyecto, y completá los 3 valores con los mismos que ya cargaste en Vercel
# (Supabase Dashboard -> tu proyecto -> Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Seguís necesitando esta hasta que migremos el catálogo/imágenes fuera de
# Vercel Blob (Vercel -> tu proyecto -> Storage -> el store de Blob -> copiar token).
BLOB_READ_WRITE_TOKEN=
