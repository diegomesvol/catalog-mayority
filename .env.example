# TODO: BLOB_READ_WRITE_TOKEN sigue acá porque el catálogo, colecciones e
# imágenes todavía viven en Vercel Blob (lib/blob.ts) — se elimina cuando esa
# capa también migre a Supabase.
# Vercel genera esta variable automáticamente al conectar Blob al proyecto
# (Storage -> Create Database -> Blob). No hace falta configurarla a mano en
# producción; en local, copiá el token desde el dashboard de Vercel si querés
# probar contra el store real.
BLOB_READ_WRITE_TOKEN=

# Supabase (Project Settings -> API). Las dos NEXT_PUBLIC_* son seguras para
# el cliente (protegidas por RLS); SUPABASE_SERVICE_ROLE_KEY nunca debe
# usarse fuera de código de servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
